# AnimateBench ZERO-SHOT (193 samples) -- google/gemini-3.7-flash via OpenRouter,
# SVG target, WITH ALL THREE CRITICS ACTIVE.
#
# Hand-derived from bench_v5_or_gemini37flash.yaml. NOT generated by
# make_v5_configs.py, whose roster is the 91-sample v5 study and whose
# CRITICS flag is False.
#
# WHY ITS OWN cache_root
#   `CachePaths` keys artifacts on the MODELS that produced them and nothing
#   else -- critic enablement is NOT part of any lineage. A critics-on run and
#   a critics-off run of the same model therefore resolve to the SAME
#   `animation_lineage`, and so to the same `exports/` directory. Sharing a
#   root with a no-critic Gemini run would let one silently serve the other's
#   artifacts. The local models' zero-shot run lives in animatebench_zs_cache;
#   this is animatebench_zs_or_cache.
#
# THE CRITICS (this is the difference that matters)
#   1c diagram_critic  renders the SVG, compares it to the source figure, and
#                      repairs -- up to 3 rounds, gated on fidelity 0.7
#   2d planner_critic  checks the traversal against the structure XML, 2 rounds
#   3b animator_critic 3 rounds, compile_check on, so a non-compiling
#                      animation is caught before export rather than at it
#
#   Each critic calls the model once per sample and does NOT batch, so wall
#   clock is dominated by them rather than by the generating stages.
#
# Critic prompts carry explicit "fix by correcting, never by deleting" clauses.
# Those are load-bearing: on three separate occasions a critic satisfied a
# finding by removing the thing the finding named (103 text references across
# 7 samples, two hand-placed raster crops, and a whole node hierarchy).
#
# THE MODEL
#   repo          google/gemini-3.7-flash
#   weights       0.0 GB
#   architecture  closed
#   serving venv  api
#
# No server: this route is OpenRouter. Needs OPEN_ROUTER_KEY in .env.

# CACHE SEPARATION. `CachePaths` keys artifacts on the MODEL STRING ALONE --
# not base_url, not the backend name. The local and OpenRouter configs for this
# model therefore use DIFFERENT cache_roots; without that the second route finds
# the first's artifacts already on disk, skips every stage, and the parity check
# silently compares a run against itself.

dataset:
  root: /fsxvision_new/venkat.kesav/img_2_svg_pretraining/data/animatebench_zs
  limit: 0

cache_root: /fsxvision_new/venkat.kesav/img_2_svg_pretraining/data/animatebench_zs_or_cache

animation_style: progressive_reveal
target: svg

backends:
  openrouter_gemini37flash:
      type: openai_compat
      base_url: https://openrouter.ai/api/v1
      model: google/gemini-3.7-flash
      api_key_env: OPEN_ROUTER_KEY
      # Raised from 4 once the key's credit cap was lifted. This stream must
      # cover all 91 cells by itself overnight, and OpenRouter fans out far
      # better than a single local server does.
      max_concurrency: 12

  # The judge. Run AFTER generation, so one load scores every config rather
  # than reloading per model. A different family from most generators here --
  # judging a model's output with itself is the circular evaluation this
  # project's notes warn against, and it is why the qwen3vl235b row needs a
  # footnote.
  qwen_judge:
    type: openai_compat
    base_url: http://127.0.0.1:8010/v1
    model: Qwen/Qwen3-VL-235B-A22B-Instruct
    api_key: EMPTY
    max_concurrency: 8

  # Kimi K2.6 as judge, served across 2 nodes on :8011.
  #
  # max_concurrency 64, not 8. The v3 animation-tree run is the cautionary
  # tale: it scored 45 cells in 3.8h at "Running: 1 reqs" against
  # --max-num-seqs 16, leaving ~94% of the server idle, because the DRIVER was
  # sequential -- one run_eval subprocess per cell. The judging work is
  # embarrassingly parallel (every cell independent), so the only thing that
  # ever limited it was how many requests were in flight. This server sustains
  # Running: 32 at ~1090 tok/s; 64 keeps the queue non-empty as cells finish.
  kimi_judge:
    type: openai_compat
    base_url: http://127.0.0.1:8011/v1
    model: moonshotai/Kimi-K2.6
    api_key: EMPTY
    max_concurrency: 8
    # THINKING OFF FOR JUDGING. Kimi emits a <think> block before any content;
    # its chat template takes `thinking: false` and pre-fills an empty one.
    # Measured on one banding call: 11.1s / 710 completion tokens with thinking
    # on, 0.2s / 6 tokens with it off -- and the reply is cleaner, a bare
    # {"band":"B"} rather than prose the parser must dig through. Over ~22k
    # judged calls that is a night instead of a week.
    #
    # A judge assigns a band against a rubric; it is not the task reasoning
    # helps. Generation keeps thinking ON -- that is `served`, a different
    # backend, and this setting does not touch it.
    default_params:
      extra_body:
        chat_template_kwargs:
          thinking: false

transmuter:
  code_converter:
    backend: openrouter_gemini37flash
    prompt: diagram_transmuter/svg_diagram_to_code.yaml#prompt
    params:
      temperature: 0.2
      max_tokens: 65536

  raster_integrator:
    enabled: true
    backend: openrouter_gemini37flash
    params:
      temperature: 0.0
      max_tokens: 65536

  diagram_critic:
    enabled: true
    backend: openrouter_gemini37flash
    prompt: diagram_transmuter/critic.yaml
    fidelity_threshold: 0.7
    max_rounds: 3
    params:
      temperature: 0.1
      max_tokens: 65536

planner:
  # Declared, never run: its model is baked into the existing lineage and
  # removing it would rewrite every scored path. `run_pipeline strategize`
  # refuses to execute.
  strategizer:
    backend: openrouter_gemini37flash
    prompt: animation_planner/strategizer.yaml#full-context-prompt
    context_tier: full

  parser:
    backend: openrouter_gemini37flash
    prompt: animation_planner/svg_parser.yaml#prompt
    params:
      temperature: 0.0
      max_tokens: 65536

  sequencer:
    backend: openrouter_gemini37flash
    prompt: animation_planner/svg_sequencer.yaml#new_prompt
    params:
      temperature: 0.3
      max_tokens: 65536

  critic:
    enabled: true
    backend: openrouter_gemini37flash
    prompt: animation_planner/critic.yaml#prompt
    max_rounds: 2
    params:
      temperature: 0.2
      max_tokens: 65536

  narrative_writer:
    backend: openrouter_gemini37flash
    prompt: animation_planner/narrative_writer.yaml
    context_tier: full
    params:
      temperature: 0.3
      max_tokens: 65536

animator:
  designer:
    backend: openrouter_gemini37flash
    # `{style}` is expanded at run time by designer._resolve_prompt.
    prompt: animation_designer/svg_designer.yaml#{style}
    params:
      temperature: 0.2
      max_tokens: 65536

  critic:
    enabled: true
    backend: openrouter_gemini37flash
    prompt: animation_designer/critic.yaml#prompt
    max_rounds: 3
    compile_check: true
    params:
      temperature: 0.2
      max_tokens: 65536

  exporter:
    # mp4 only -- an SVG animation is CSS keyframes, which no rasteriser can
    # seek. mp4 also writes exports/frames/, which the animation tree reads.
    outputs: [mp4]
    fps: 2
    dpi: 300
